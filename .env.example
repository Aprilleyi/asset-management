# Copy only the settings you need to backend/.env for Mac development.
# Docker Compose reads an untracked root .env for interpolation.
# Never commit real credentials or production data.
ASSET_MANAGER_DATABASE_PATH=../data/asset_dev.sqlite3
ASSET_MANAGER_BACKUP_DIR=../backups
ASSET_MANAGER_UPLOAD_DIR=../data/ocr_uploads
ASSET_MANAGER_OCR_CACHE_DIR=../data/paddleocr_home
ASSET_MANAGER_SCHEDULER_ENABLED=false
ASSET_MANAGER_SCHEDULER_TIMEZONE=Asia/Shanghai
ASSET_MANAGER_API_HOST=127.0.0.1
ASSET_MANAGER_API_PORT=8000
ASSET_MANAGER_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
ASSET_MANAGER_OCR_PROVIDER=none
ASSET_MANAGER_OCR_LOCAL_PYTHON_PATH=
ASSET_MANAGER_OCR_LOCAL_PYTHON_HOME=
ASSET_MANAGER_OCR_LOCAL_ENDPOINTS=[]
ASSET_MANAGER_OCR_ENDPOINT=
ASSET_MANAGER_OCR_API_KEY=
ASSET_MANAGER_OCR_MODEL=
ASSET_MANAGER_OCR_TIMEOUT_SECONDS=30
ASSET_MANAGER_FRONTEND_PORT=8088
ASSET_MANAGER_DOCKER_DATABASE_PATH=/srv/runtime/data/asset_test.sqlite3
ASSET_MANAGER_DOCKER_SCHEDULER_ENABLED=false

# Linux Compose uses an isolated test DB by default. After a separately approved
# production promotion, set ASSET_MANAGER_DOCKER_DATABASE_PATH to
# /srv/runtime/data/asset_prod.sqlite3 and explicitly enable the scheduler.
# Other container paths are /srv/runtime/backups,
# /srv/runtime/uploads, /srv/runtime/ocr-cache.
# Keep the server's root .env private; never copy the Mac database path into it.
